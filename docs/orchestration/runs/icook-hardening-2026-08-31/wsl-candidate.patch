+#[cfg(target_os = "windows")]
+#[derive(Default)]
+struct CapturedStderr {
+    bytes: Vec<u8>,
+    complete: bool,
+}
+
+#[cfg(target_os = "windows")]
+fn spawn_stderr_reader(stderr: ChildStderr, capture: Arc<Mutex<CapturedStderr>>) {
+    std::thread::spawn(move || {
+        let mut reader = stderr;
+        let mut buffer = [0_u8; 512];
+        loop {
+            match reader.read(&mut buffer) {
+                Ok(0) | Err(_) => {
+                    if let Ok(mut captured) = capture.lock() {
+                        captured.complete = true;
+                    }
+                    return;
+                }
+                Ok(count) => {
+                    if let Ok(mut captured) = capture.lock() {
+                        let remaining =
+                            MAX_CAPTURED_STDERR_BYTES.saturating_sub(captured.bytes.len());
+                        captured.bytes.extend_from_slice(&buffer[..count.min(remaining)]);
+                    } else {
+                        return;
+                    }
+                }
+            }
+        }
+    });
+}
+
+#[cfg(target_os = "windows")]
+fn bounded_stderr(capture: &Mutex<CapturedStderr>) -> Vec<u8> {
+    let deadline = Instant::now() + Duration::from_millis(50);
+    loop {
+        let Ok(captured) = capture.lock() else {
+            return Vec::new();
+        };
+        let snapshot = captured.bytes.clone();
+        if captured.complete || Instant::now() >= deadline {
+            return snapshot;
+        }
+        drop(captured);
+        std::thread::sleep(Duration::from_millis(2));
+    }
+}
+
+#[cfg(target_os = "windows")]
+fn terminate_child(child: &mut Child) -> Option<ExitStatus> {
+    let _ = child.kill();
+    let deadline = Instant::now() + Duration::from_millis(200);
+    loop {
+        match child.try_wait() {
+            Ok(Some(status)) => return Some(status),
+            Ok(None) if Instant::now() < deadline => {
+                std::thread::sleep(Duration::from_millis(5));
+            }
+            Ok(None) | Err(_) => return None,
+        }
+    }
+}
