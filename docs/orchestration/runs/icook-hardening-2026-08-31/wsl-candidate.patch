+    #[test]
+    fn child_failure_diagnostics_are_bounded_and_never_echo_stderr() {
+        let secret = "synthetic-secret-marker";
+        let stderr = format!("unexpected output {secret}");
+        let error = child_failure_error(
+            AgentErrorCategory::ChildExit,
+            "el agente termino",
+            None,
+            stderr.as_bytes(),
+        );
+
+        assert!(error.message.contains("diagnostico: unknown"));
+        assert!(!error.message.contains(secret));
+
+        let permission = child_failure_error(
+            AgentErrorCategory::ChildExit,
+            "el agente termino",
+            None,
+            b"Access is denied",
+        );
+        assert!(permission.message.contains("diagnostico: permission denied"));
+
+        let bounded = vec![b'x'; MAX_CAPTURED_STDERR_BYTES * 2];
+        assert_eq!(safe_stderr_diagnostic(&bounded), DIAGNOSTIC_UNKNOWN);
+    }
+
+    #[cfg(target_os = "windows")]
+    #[test]
+    fn one_shot_eof_retains_exit_code_without_echoing_stderr() {
+        let command = std::env::var("ComSpec").expect("ComSpec");
+        let argv = vec![
+            command,
+            "/C".to_string(),
+            "echo synthetic-secret-marker 1>&2 & exit /b 17".to_string(),
+        ];
+
+        let error = StdCommandTransport
+            .exchange(&argv, "{}\n", Duration::from_secs(2))
+            .expect_err("child should exit without a response");
+
+        assert_eq!(error.category, AgentErrorCategory::ChildExit);
+        assert!(error.message.contains("codigo de salida: 17"));
+        assert!(!error.message.contains("synthetic-secret-marker"));
+    }
