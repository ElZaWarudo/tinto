+#[cfg(any(target_os = "windows", test))]
+fn safe_stderr_diagnostic(stderr: &[u8]) -> &'static str {
+    let text = String::from_utf8_lossy(stderr).to_ascii_lowercase();
+    if text.contains("permission denied")
+        || text.contains("access is denied")
+        || text.contains("permiso denegado")
+    {
+        return "permission denied";
+    }
+    if text.contains("not recognized as an internal or external command")
+        || text.contains("command not found")
+        || text.contains("executable file not found")
+        || text.contains("no such file or directory")
+        || text.contains("cannot find the file")
+        || text.contains("file not found")
+    {
+        return "missing executable";
+    }
+    DIAGNOSTIC_UNKNOWN
+}
