+#[cfg(target_os = "windows")]
+#[derive(Default)]
+struct ProcessStderr {
+    tail: Vec<u8>,
+    truncated: bool,
+}
+
+#[cfg(target_os = "windows")]
+impl ProcessStderr {
+    fn append(&mut self, bytes: &[u8]) {
+        const LIMIT: usize = 4096;
+        let overflow = (self.tail.len() + bytes.len()).saturating_sub(LIMIT);
+        self.truncated |= overflow > 0;
+        let discard = overflow.min(self.tail.len());
+        self.tail.drain(..discard);
+        self.tail.extend_from_slice(&bytes[bytes.len().saturating_sub(LIMIT)..]);
+    }
+
+    fn label(&self) -> &'static str {
+        let text = String::from_utf8_lossy(&self.tail).to_ascii_lowercase();
+        if text.contains("permission denied") || text.contains("access is denied") {
+            "stderr indica acceso denegado"
+        } else if text.contains("command not found") || text.contains("no such file or directory") {
+            "stderr indica comando o archivo no encontrado"
+        } else if self.tail.is_empty() {
+            "stderr no disponible"
+        } else {
+            "causa de stderr no reconocida; contenido omitido"
+        }
+    }
+}
+
+#[cfg(target_os = "windows")]
+fn drain_process_stderr(mut reader: impl Read, capture: &Mutex<ProcessStderr>) {
+    let mut buffer = [0_u8; 512];
+    while let Ok(count) = reader.read(&mut buffer) {
+        if count == 0 {
+            break;
+        }
+        if let Ok(mut captured) = capture.lock() {
+            captured.append(&buffer[..count]);
+        }
+    }
+}
+
+#[cfg(target_os = "windows")]
+fn capture_process_stderr(child: &mut Child) -> Arc<Mutex<ProcessStderr>> {
+    let capture = Arc::new(Mutex::new(ProcessStderr::default()));
+    if let Some(stderr) = child.stderr.take() {
+        let target = Arc::clone(&capture);
+        std::thread::spawn(move || drain_process_stderr(stderr, &target));
+    }
+    capture
+}
+
+#[cfg(target_os = "windows")]
+fn with_process_diagnostics(
+    mut error: AgentError,
+    status: Option<ExitStatus>,
+    capture: &Mutex<ProcessStderr>,
+) -> AgentError {
+    let exit = status.and_then(|status| status.code())
+        .map(|code| code.to_string())
+        .unwrap_or_else(|| "no disponible".to_string());
+    error.message.push_str(&format!("; codigo de salida: {exit}"));
+    if let Ok(captured) = capture.lock() {
+        error.message.push_str("; ");
+        error.message.push_str(captured.label());
+        if captured.truncated {
+            error.message.push_str("; stderr recortado");
+        }
+    }
+    error
+}
