{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krt.local/real-world-edge-testing/preflight.schema.json",
  "title": "Real-World Edge Testing Preflight Result",
  "type": "object",
  "required": ["schemaVersion", "status", "checks", "blockers"],
  "properties": {
    "schemaVersion": {"const": 1},
    "status": {"enum": ["passed", "blocked"]},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["condition", "status", "evidence"],
        "properties": {
          "condition": {"type": "string", "minLength": 1},
          "status": {"enum": ["passed", "failed"]},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["condition", "reason"],
        "properties": {
          "condition": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
