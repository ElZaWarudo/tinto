{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krt.local/real-world-edge-testing/evidence.schema.json",
  "title": "Real-World Edge Testing Evidence",
  "type": "object",
  "required": ["schemaVersion", "records"],
  "properties": {
    "schemaVersion": {"const": 1},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "caseId", "result", "durationMs", "observed", "artifacts",
          "mutations", "recoveryStatus", "sanitized"
        ],
        "properties": {
          "caseId": {"type": "string", "minLength": 1},
          "result": {"enum": ["pass", "fail", "blocked", "not_run"]},
          "durationMs": {"type": "integer", "minimum": 0},
          "observed": {"type": "object", "minProperties": 1},
          "artifacts": {
            "type": "array",
            "maxItems": 1000,
            "items": {"type": "string", "pattern": "^evidence/"}
          },
          "mutations": {"type": "array"},
          "recoveryStatus": {
            "enum": ["not_required", "pending", "recovered", "failed_recovery", "blocked"]
          },
          "sanitized": {"const": true},
          "startedAt": {"type": "string", "format": "date-time"},
          "oracleDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "oracleResult": {
            "type": "object",
            "required": ["passed", "details"],
            "properties": {
              "passed": {"type": "boolean"},
              "details": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "pattern": "\\S"}
              }
            }
          }
        },
        "allOf": [
          {
            "if": {"properties": {"result": {"enum": ["pass", "fail"]}}},
            "then": {"required": ["startedAt", "oracleDigest", "oracleResult"]}
          }
        ]
      }
    }
  }
}
